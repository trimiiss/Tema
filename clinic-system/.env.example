# OpenAI
OPENAI_API_KEY=sk-...

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...
SUPABASE_JWT_SECRET=your-jwt-secret

# Backend
BACKEND_URL=http://backend:8000
SECRET_KEY=change-me-to-random-secret
# Wall-clock timezone the clinic runs on. Working hours and generated slots are
# read in this zone. IANA has no Europe/Pristina entry; Europe/Tirane carries
# the same CET/CEST offsets and EU DST rules Kosovo observes.
CLINIC_TIMEZONE=Europe/Tirane
# Fallback hours for doctors with no schedule configured. 0=Mon … 6=Sun.
DEFAULT_WORK_DAYS=0,1,2,3,4
DEFAULT_WORK_START=09:00
DEFAULT_WORK_END=17:00

# Frontend (Next.js public vars)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
