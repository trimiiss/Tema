# Build-time configuration for the Vercel production build.
#
# Everything here is NEXT_PUBLIC_*, which means Next.js inlines it into the
# JavaScript that ships to the browser. None of it can be a secret: the anon
# key is designed to be public and is only as safe as the Supabase RLS
# policies behind it, and the two URLs are hostnames anyone can read off the
# network tab. So it is committed rather than typed into the Vercel dashboard,
# for the same reason CORS_ORIGINS is committed in render.yaml — one less
# setting that can silently go missing when the project is recreated, and one
# less way for a build to succeed while the running site talks to nothing.
#
# Real secrets (service-role key, OpenAI key, JWT secret) live on the backend
# only and must never appear in this file.
#
# Vercel dashboard variables win over this file, so anything set there
# overrides these defaults without a code change.

NEXT_PUBLIC_SUPABASE_URL=https://yvtdcocziagygqooxabu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inl2dGRjb2N6aWFneWdxb294YWJ1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODQ4MjQ2MzMsImV4cCI6MjEwMDQwMDYzM30.chiDi5eOjzcTjAGRSnzVdQ3FNLBmgmPP8faIQ1ZhwIA

# The Render service from render.yaml. The browser calls this host directly
# (see src/lib/api.ts), so it must also be listed in the backend's
# CORS_ORIGINS or every request from the deployed site fails preflight.
NEXT_PUBLIC_BACKEND_URL=https://clinic-backend-ip9j.onrender.com
